// Database schema. Models are added milestone by milestone.
// After changing this file, run `npm run db:migrate -w server`.
//
// Naming: models and fields are camelCase in TypeScript, and mapped to
// snake_case tables and columns in PostgreSQL (the SQL convention).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMIN
}

enum Language {
  en
  fr
  ar
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  // Username as the player typed it ("Shadow_Monarch"), shown in the UI
  username           String    @db.VarChar(20)
  // Lowercase copy used for uniqueness, so "Ahmed" and "ahmed" cannot both exist
  usernameNormalized String    @unique @map("username_normalized") @db.VarChar(20)
  email              String    @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash")
  role               Role      @default(PLAYER)
  language           Language  @default(en)
  timezone           String    @default("UTC") @db.VarChar(64)
  avatarKey          String?   @map("avatar_key") @db.VarChar(32)
  bio                String?   @db.VarChar(160)
  onboardedAt        DateTime? @map("onboarded_at")

  // Progression. total_xp, level and rank are cached copies (SRS §7.3): they are always
  // updated in the same transaction as the XP ledger, so they never disagree with it.
  totalXp             Int     @default(0) @map("total_xp")
  level               Int     @default(1)
  rank                String  @default("E4") @db.VarChar(4)
  currentStreak       Int     @default(0) @map("current_streak")
  bestStreak          Int     @default(0) @map("best_streak")
  // Streak the penalty quest can restore; null when there is nothing to restore
  streakBeforePenalty Int?    @map("streak_before_penalty")
  activeTitleId       String? @map("active_title_id") @db.Uuid

  // Quest engine
  dailyMinutes     Int       @default(60) @map("daily_minutes")
  // Last local day (in the player's time zone) whose quests were generated.
  // The daily rollover processes every day after it (SRS §3.6).
  lastRolloverDate DateTime? @map("last_rollover_date") @db.Date
  rerollsUsed      Int       @default(0) @map("rerolls_used")
  rerollsDate      DateTime? @map("rerolls_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stats            PlayerStats?
  xpTransactions   XpTransaction[]
  titles           UserTitle[]
  achievements     UserAchievement[]
  activeTitle      Title?             @relation("ActiveTitle", fields: [activeTitleId], references: [id], onDelete: SetNull)
  focusAreas       FocusArea[]
  quests           Quest[]
  dailyLogs        DailyLog[]
  goals            Goal[]
  notifications    Notification[]
  sentRequests     Friendship[]       @relation("FriendshipRequester")
  receivedRequests Friendship[]       @relation("FriendshipAddressee")
  claims           AchievementClaim[] @relation("ClaimPlayer")
  reviewedClaims   AchievementClaim[] @relation("ClaimReviewer")

  @@map("users")
}

enum Category {
  FITNESS
  STUDIES
  LANGUAGES
  READING
  CAREER
  HEALTH
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Difficulty {
  EASY
  NORMAL
  HARD
  EXTREME
}

// A goal area chosen during onboarding, with the player's level in it
model FocusArea {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  category       Category
  level          SkillLevel
  // Quests completed at the current level; resets when the level goes up
  completedCount Int        @default(0) @map("completed_count")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("focus_areas")
}

enum TemplateType {
  DAILY
  WEEKLY
  PENALTY
  ONBOARDING
}

// Library of quests the engine picks from
model QuestTemplate {
  id         String       @id @default(uuid()) @db.Uuid
  // Stable identifier used by the seed, e.g. "fitness.beginner.1"
  key        String       @unique @db.VarChar(64)
  category   Category
  level      SkillLevel
  type       TemplateType
  // Translations: { "en": "...", "fr": "...", "ar": "..." }
  title      Json
  // Estimated duration, used only to fill the player's daily time (never for XP)
  minutes    Int
  difficulty Difficulty
  active     Boolean      @default(true)

  quests Quest[]

  @@index([type, category, level])
  @@map("quest_templates")
}

enum QuestSource {
  SYSTEM
  CUSTOM
  PENALTY
}

enum QuestType {
  DAILY
  WEEKLY
  ONE_TIME
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  FAILED
  REPLACED // rerolled
}

model Quest {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  templateId  String?     @map("template_id") @db.Uuid
  // Custom quests can be linked to a milestone of one of the player's goals
  milestoneId String?     @map("milestone_id") @db.Uuid
  source      QuestSource
  type        QuestType
  // Only for custom quests; system quests take their title from the template
  title       String?     @db.VarChar(120)
  description String?     @db.VarChar(1000)
  category    Category
  difficulty  Difficulty
  minutes     Int?
  // Base XP, calculated when the quest is created (SRS §3.2)
  xpReward    Int         @map("xp_reward")
  status      QuestStatus @default(ACTIVE)
  // Local day (daily quests) or Monday of the week (weekly quests) it belongs to
  questDate   DateTime    @map("quest_date") @db.Date
  dueAt       DateTime    @map("due_at")
  completedAt DateTime?   @map("completed_at")
  // XP actually given at completion (streak bonus included)
  xpAwarded   Int?        @map("xp_awarded")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      QuestTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Deleting a milestone keeps its quests, just without the link
  milestone     Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  xpTransaction XpTransaction?

  @@index([userId, questDate])
  @@index([userId, status])
  @@map("quests")
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

// A long-term goal ("Get a Java internship"), broken into milestones (SRS §4.4)
model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  title       String     @db.VarChar(120)
  description String?    @db.VarChar(1000)
  category    Category
  targetDate  DateTime?  @map("target_date") @db.Date
  status      GoalStatus @default(ACTIVE)
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([userId, status])
  @@map("goals")
}

model Milestone {
  id          String    @id @default(uuid()) @db.Uuid
  goalId      String    @map("goal_id") @db.Uuid
  title       String    @db.VarChar(120)
  // Order inside the goal: 0, 1, 2...
  position    Int
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  quests Quest[]

  @@index([goalId, position])
  @@map("milestones")
}

enum NotificationType {
  ACHIEVEMENT_UNLOCKED
  RANK_UP
  PENALTY_QUEST
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  CLAIM_APPROVED
  CLAIM_REJECTED
}

enum AchievementTier {
  LEGENDARY
  MYTHIC
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

// Real-life achievements players can claim (SRS §4.7)
model LegendaryQuest {
  id       String          @id @default(uuid()) @db.Uuid
  key      String          @unique @db.VarChar(64)
  title    Json
  category Category
  tier     AchievementTier
  xpReward Int             @map("xp_reward")
  titleId  String?         @map("title_id") @db.Uuid
  active   Boolean         @default(true)

  rewardTitle Title?             @relation(fields: [titleId], references: [id], onDelete: SetNull)
  claims      AchievementClaim[]

  @@map("legendary_quests")
}

// A player's request to have a real-life achievement verified by an admin
model AchievementClaim {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  // null for a free-form claim (an extraordinary achievement not in the catalog)
  legendaryQuestId String?          @map("legendary_quest_id") @db.Uuid
  title            String?          @db.VarChar(120)
  description      String           @db.VarChar(2000)
  proofUrl         String           @map("proof_url") @db.VarChar(500)
  status           ClaimStatus      @default(PENDING)
  tierAwarded      AchievementTier? @map("tier_awarded")
  xpAwarded        Int?             @map("xp_awarded")
  titleAwardedId   String?          @map("title_awarded_id") @db.Uuid
  reviewerId       String?          @map("reviewer_id") @db.Uuid
  reviewNote       String?          @map("review_note") @db.VarChar(500)
  createdAt        DateTime         @default(now()) @map("created_at")
  reviewedAt       DateTime?        @map("reviewed_at")

  user           User            @relation("ClaimPlayer", fields: [userId], references: [id], onDelete: Cascade)
  reviewer       User?           @relation("ClaimReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  legendaryQuest LegendaryQuest? @relation(fields: [legendaryQuestId], references: [id], onDelete: SetNull)
  titleAwarded   Title?          @relation("ClaimTitle", fields: [titleAwardedId], references: [id], onDelete: SetNull)
  xpTransaction  XpTransaction?

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("achievement_claims")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// A friend request, then a friendship once accepted (SRS §4.6). Declining or removing
// a friend deletes the row. Only one row can exist per pair of players, whatever the
// direction: enforced by a unique index on (LEAST, GREATEST) added in the migration.
model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  respondedAt DateTime?        @map("responded_at")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

// In-app notifications (SRS §4.8). The text is built by the frontend from the type
// and data, so it is always shown in the player's current language.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  // e.g. { "code": "STREAK_7" } or { "rank": "C4" }
  data      Json             @default("{}")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// One row per finished day: used for the streak, the discipline rate and the calendar
model DailyLog {
  userId          String   @map("user_id") @db.Uuid
  date            DateTime @db.Date
  questsTotal     Int      @map("quests_total")
  questsCompleted Int      @map("quests_completed")
  allCompleted    Boolean  @map("all_completed")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@map("daily_logs")
}

// One row per player (1:1 with users)
model PlayerStats {
  userId       String @id @map("user_id") @db.Uuid
  strength     Int    @default(0)
  intelligence Int    @default(0)
  discipline   Int    @default(0)
  consistency  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_stats")
}

enum XpReason {
  QUEST
  CLAIM
  ADMIN_ADJUSTMENT
}

// The XP ledger: every XP gain ever, with its reason. A player's total XP is the sum
// of their rows. The link to a claim is added with claims (Milestone 8).
model XpTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Int
  reason    XpReason
  // Unique: a quest can never reward XP twice, even if a bug or a double click tries
  questId   String?  @unique @map("quest_id") @db.Uuid
  // Unique too: an approved claim pays once
  claimId   String?  @unique @map("claim_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest?            @relation(fields: [questId], references: [id], onDelete: SetNull)
  claim AchievementClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  // For "XP earned this week" and the XP history chart
  @@index([userId, createdAt])
  @@map("xp_transactions")
}

enum TitleRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

model Title {
  id        String      @id @default(uuid()) @db.Uuid
  // Stable identifier used in code and seed data, e.g. "iron_will"
  key       String      @unique @db.VarChar(64)
  // Translations: { "en": "Iron Will", "fr": "Volonté de fer", "ar": "إرادة حديدية" }
  name      Json
  rarity    TitleRarity
  createdAt DateTime    @default(now()) @map("created_at")

  earnedBy     UserTitle[]
  achievements Achievement[]
  activeFor    User[]             @relation("ActiveTitle")
  legendary    LegendaryQuest[]
  claims       AchievementClaim[] @relation("ClaimTitle")

  @@map("titles")
}

model UserTitle {
  userId   String   @map("user_id") @db.Uuid
  titleId  String   @map("title_id") @db.Uuid
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([userId, titleId])
  @@map("user_titles")
}

// Achievement definitions. Unlock conditions live in code; names and descriptions
// live in the frontend translation files. This table exists so unlocks can reference
// it and so an achievement can grant a title.
model Achievement {
  code    String  @id @db.VarChar(32)
  titleId String? @map("title_id") @db.Uuid

  title      Title?            @relation(fields: [titleId], references: [id], onDelete: SetNull)
  unlockedBy UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId          String   @map("user_id") @db.Uuid
  achievementCode String   @map("achievement_code") @db.VarChar(32)
  unlockedAt      DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementCode], references: [code], onDelete: Cascade)

  @@id([userId, achievementCode])
  @@map("user_achievements")
}
