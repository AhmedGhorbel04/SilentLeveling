# Copy this file to `.env` and adjust the values.
# `.env` is ignored by Git — never commit real secrets.

NODE_ENV=development
PORT=4000

# Local database started with `npm run db:up` (see docker-compose.yml)
DATABASE_URL=postgresql://silent:silent_dev_password@localhost:5433/silentleveling

# Frontend URL allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens (min. 32 characters). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=10

# Number of proxies in front of the API in production (Render + Vercel rewrite = 2)
TRUST_PROXY_HOPS=1

# Optional: quest reminders (push notifications). Generate a key pair once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Secret the scheduled job sends to POST /api/cron/reminders (min. 32 characters)
CRON_SECRET=
