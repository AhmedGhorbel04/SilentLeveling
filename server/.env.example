# Copy this file to `.env` and adjust the values.
# `.env` is ignored by Git — never commit real secrets.

NODE_ENV=development
PORT=4000

# Local database started with `npm run db:up` (see docker-compose.yml)
DATABASE_URL=postgresql://silent:silent_dev_password@localhost:5433/silentleveling

# Frontend URL allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens (min. 32 characters). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=10
